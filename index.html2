<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0d0f14">
  <title>HELIX | Profile</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a0c10;
      color: #f1f5f9;
      overflow-x: hidden;
    }

    /* Background blur effect like guns.lol */
    .bg {
      position: fixed;
      inset: 0;
      background: url('assets/yellow-wallpaper.jpg') center/cover no-repeat;
      filter: blur(18px) brightness(0.45);
      transform: scale(1.1);
      z-index: 0;
    }

    .page {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 420px;
      padding: 20px;
    }

    .profile-card {
      background: rgba(18, 20, 28, 0.82);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      padding: 36px 28px 28px;
      text-align: center;
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.6);
    }

    .avatar {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.12);
      margin-bottom: 18px;
      box-shadow: 0 0 30px rgba(0,0,0,0.4);
    }

    h1 {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 10px;
      color: #fff;
    }

    .bio {
      font-size: 0.95rem;
      font-weight: 500;
      color: #e2e8f0;
      line-height: 1.5;
      margin-bottom: 14px;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }

    .location {
      font-size: 0.88rem;
      color: #94a3b8;
      margin-bottom: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .socials {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .socials a,
    .socials button,
    .socials .inactive {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #f1f5f9;
      text-decoration: none;
      font-size: 0;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .socials a:hover,
    .socials button:hover {
      background: rgba(255,255,255,0.12);
      transform: translateY(-3px);
    }

    .socials .inactive {
      opacity: 0.4;
      cursor: default;
    }

    /* Simple icons using text for now */
    .socials a[href*="wa.me"]::before { content: "WA"; font-size: 13px; font-weight: 700; }
    .socials a[href*="t.me"]::before { content: "TG"; font-size: 13px; font-weight: 700; }
    .socials a[href*="mailto"]::before { content: "@"; font-size: 18px; font-weight: 700; }
    .socials .inactive::before { content: "IG"; font-size: 13px; font-weight: 700; }
    #discordBtn::before { content: "DC"; font-size: 13px; font-weight: 700; }

    .nitro {
      display: none;
    }

    .discord-note {
      font-size: 0.75rem;
      color: #64748b;
      margin-bottom: 22px;
    }

    .card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .views {
      font-size: 0.82rem;
      color: #94a3b8;
    }

    .coffee {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #f59e0b;
      color: #111;
      font-weight: 700;
      font-size: 0.85rem;
      padding: 9px 16px;
      border-radius: 50px;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .coffee:hover {
      background: #fbbf24;
      transform: translateY(-2px);
    }

    footer {
      text-align: center;
      margin-top: 24px;
      font-size: 0.75rem;
      color: #475569;
    }

    @media (max-width: 420px) {
      .profile-card {
        padding: 28px 20px 24px;
      }
      h1 {
        font-size: 1.75rem;
      }
    }
  </style>
</head>
<body>

  <div class="bg"></div>

  <main class="page">
    <section class="profile-card">

      <img
        class="avatar"
        src="assets/yellow-wallpaper.jpg"
        alt="HELIX profile"
      >

      <h1>HELIX</h1>

      <p class="bio">GAMER, CODER, INTELLECTUAL</p>

      <p class="location">📍 JAPAN | TOKYO</p>

      <nav class="socials" aria-label="Social links">

        <a href="https://wa.me/qr/G7AQHSBORO5BA1?s=r"
           target="_blank" rel="noopener noreferrer"
           aria-label="WhatsApp"></a>

        <span class="inactive" title="Instagram deactivated"></span>

        <a href="https://t.me/kleinmoretti_24"
           target="_blank" rel="noopener noreferrer"
           aria-label="Telegram"></a>

        <a href="mailto:helixsaintlauren24@gmail.com"
           aria-label="Email"></a>

        <button id="discordBtn" type="button" aria-label="Discord">
          <span class="nitro">NITRO</span>
        </button>

      </nav>

      <p class="discord-note">DISCORD LINK COMING LATER</p>

      <div class="card-bottom">
        <span class="views">
          👁 <span id="viewCount">—</span> views
        </span>

        <a class="coffee"
           href="upi://pay?pa=prathameshvaishnav12@okaxis&pn=HELIX&cu=INR&tn=Coffee%20for%20HELIX"
           target="_blank" rel="noopener">
          ☕ Buy me a coffee
        </a>
      </div>

    </section>

    <footer>HELIX · PERSONAL PROFILE</footer>
  </main>

  <script>
    // Simple view counter
    const key = 'helix-profile-views';
    fetch(`https://api.countapi.xyz/hit/helix/${key}`)
      .then(r => r.json())
      .then(d => {
        document.getElementById('viewCount').textContent = d.value.toLocaleString();
      })
      .catch(() => {
        document.getElementById('viewCount').textContent = '—';
      });
  </script>
</body>
</html>
